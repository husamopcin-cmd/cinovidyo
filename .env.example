# CinoVidyo V1 — gerçek secret değerlerini bu dosyaya yazmayın.
STORAGE_DRIVER=local

# Google Cloud Text-to-Speech
TTS_PROVIDER=google
TTS_API_KEY=

# Alternatif özel TTS sağlayıcısı kullanılırsa:
# TTS_PROVIDER=custom
# TTS_API_URL=https://example.com/tts
# TTS_API_KEY=

# İsteğe bağlı AI asistan
ANTHROPIC_API_KEY=
